{
  "name": "@morphd/cli",
  "version": "0.5.0",
  "description": "morphd setup, doctor, update and uninstall launcher",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "morphd": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs').then(fs=>fs.chmodSync('dist/index.js',0o755))\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/cli.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3"
  },
  "optionalDependencies": {
    "@morphd/linux-x64": "0.5.0",
    "@morphd/linux-arm64": "0.5.0",
    "@morphd/darwin-x64": "0.5.0",
    "@morphd/darwin-arm64": "0.5.0",
    "@morphd/win32-x64": "0.5.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
