#!/usr/bin/env python3
import sys, os, json, uuid
from pathlib import Path
args=sys.argv[1:]
if '--version' in args:
    print('codex-cli 0.144.6'); raise SystemExit(0)
if args[:2]==['exec','resume'] and '--help' in args:
    print('Usage: codex exec resume <session-id> <prompt> [options]\n  --json'); raise SystemExit(0)
if args[:1]==['resume'] and '--help' in args:
    print('Usage: codex resume <session-id> [prompt]'); raise SystemExit(0)
if args[:1]==['exec'] and '--help' in args:
    print('codex exec [prompt] --model M --json --skip-git-repo-check --sandbox workspace-write --ask-for-approval never --ephemeral --add-dir DIR'); raise SystemExit(0)
if not args or args[0]!='exec':
    print('bad invocation', file=sys.stderr); raise SystemExit(2)
resume = len(args)>1 and args[1]=='resume'
if resume:
    sid=args[2]; prompt=args[3]
else:
    sid=None; prompt=args[1]
home=Path(os.environ['CODEX_HOME']); state=home/'fake-state.json'
data=json.loads(state.read_text(encoding="utf-8")) if state.exists() else {'turns':0,'sid':None}
if resume: sid=sid or data.get('sid')
if not sid:
    sid=f'thread-{uuid.uuid4().hex[:10]}'
turn=data['turns']+1
fail = ('FAIL_FIRST' in prompt and turn==1)
if os.environ.get('FAKE_REQUIRE_MARKER'):
    agents = Path('AGENTS.md')
    if not agents.is_file() or 'MORPHD_IMPROVED' not in agents.read_text(encoding='utf-8', errors='replace'):
        fail = True
data={'turns':turn,'sid':sid}; state.write_text(json.dumps(data), encoding="utf-8")
print(json.dumps({'type':'thread.started','thread_id':sid}))
print(json.dumps({'type':'item.completed','item':{'id':'i1','type':'command_execution','command':'echo hi','status':'failed' if fail else 'completed','exit_code':1 if fail else 0,'aggregated_output':'boom' if fail else 'hi'}}))
if not fail:
    Path('hello.txt').write_text('hello from fake codex\n', encoding="utf-8")
print(json.dumps({'type':'item.completed','item':{'id':'i2','type':'agent_message','text':'done' if not fail else 'failed'}}))
if fail:
    print(json.dumps({'type':'turn.failed','error':{'message':'fake failure'}}))
    raise SystemExit(1)
print(json.dumps({'type':'turn.completed','usage':{'input_tokens':100,'cached_input_tokens':10,'output_tokens':20,'reasoning_output_tokens':5}}))
raise SystemExit(0)
