# morphd environment reference. Never commit real credentials.

# ---------------------------------------------------------------------------
# Consumer / host-bound product
# ---------------------------------------------------------------------------
MORPHD_HOME=$HOME/.morphd
# Optional engine binary (NPM launcher/Electron); otherwise a platform package is used.
# MORPHD_ENGINE_BIN=/opt/morphd/morphd-engine
# Development-only Python interpreter selection for the NPM launcher.
# MORPHD_PYTHON=python3.12
# dsh idle fallback: only after a final turn/end and this many seconds unchanged.
MORPHD_SESSION_IDLE_S=60
# Optional tray helper environment (browser path; no effect without a desktop tray).
# MORPHD_TRAY=1
# Local encrypted vault passphrase. Prefer entering it in the UI; if set here it is a secret.
# MORPHD_VAULT_PASSPHRASE=

# ---------------------------------------------------------------------------
# Engine / advanced enterprise path
# ---------------------------------------------------------------------------
MORPHD_TASKS=$HOME/.morphd/tasks
MORPHD_RUNS=$HOME/.morphd/runs
MORPHD_PRICING=$HOME/.morphd/pricing.yaml

# Upstream checkout (only needed when harness2 is not pip-installed)
# MORPHD_HARNESS2_SRC=/opt/harness2

# Proposer channel for the strict engine path (claude_cli | opencode).
# Consumer BYOK models are configured in the Web UI, not here.
MORPHD_PROPOSER_CHANNEL=opencode
# MORPHD_PROPOSER_MODEL=provider/model
# HARNESS2_IMPROVER_MODEL=provider/model

# Runtime models (one pinned model per runtime; never change mid-batch)
# MORPHD_DSH_MODEL=deepseek-flash
# MORPHD_CODEX_MODEL=
# MORPHD_CLAUDE_MODEL=
MORPHD_DSH_PROVIDER=deepseek-official

# Runtime binaries (default: dsh / codex / claude on PATH)
# MORPHD_DSH_BIN=/usr/local/bin/dsh
# MORPHD_CODEX_BIN=/usr/local/bin/codex
# MORPHD_CLAUDE_BIN=/usr/local/bin/claude
# Optional CODEX_HOME template (must contain no credentials): provider/model config only.
# MORPHD_CODEX_HOME_TEMPLATE=/etc/morphd/codex-home

# Pinned versions (do not change without a compatibility run)
MORPHD_DSH_VERSION=0.2.1-rc.2
MORPHD_CODEX_VERSION=0.144.6
MORPHD_CLAUDE_VERSION=2.1.302

# Runtime limits
MORPHD_TIMEOUT_S=1800
MORPHD_OBS_TRUNC=50000

# Claude Code fixed baseline (no bypass)
MORPHD_CLAUDE_PERMISSION_MODE=acceptEdits
MORPHD_CLAUDE_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep,Bash
MORPHD_CLAUDE_DISALLOWED_TOOLS=WebFetch,WebSearch
MORPHD_CLAUDE_EFFORT=high
MORPHD_CODEX_EFFORT=high

# Codex fixed baseline in code: --sandbox workspace-write --ask-for-approval never.
# There is deliberately no bypass environment switch.

# Controlled dsh answerer (offline profiles only)
MORPHD_APPROVER_ALLOW_TOOLS=bash,shell,read,write,edit,apply_patch,glob,grep,list_dir,view_image
MORPHD_APPROVER_DENY=rm -rf /,sudo,shutdown,reboot,mkfs,dd if=,danger-full-access,git push,--force,curl,wget,nc ,netcat,ssh ,scp ,/etc/,~/.ssh

# Execution boundary. Consumer default is host-native sandbox; container is strict opt-in.
MORPHD_CONTAINER_REQUIRED=0
# Set these ONLY inside an isolated container for strict/enterprise runs.
# MORPHD_CONTAINER_ISOLATED=1
# MORPHD_EGRESS_ENFORCED=1
# MORPHD_EGRESS_ALLOWLIST=api.deepseek.com,api.anthropic.com,api.openai.com

# Promotion targets (strict engine path)
# MORPHD_DSH_TARGET_HOME=/srv/dsh-home
# MORPHD_CODEX_TARGET=/srv/project
# MORPHD_CLAUDE_TARGET=/srv/project

# Host credentials are never read by discovery and are never passed to candidates.
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
